# Copy to backend/.env and fill in real values. Never commit .env.

APP_ENV=development
ENABLE_CORS=1
ALLOWED_ORIGINS=*

JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

GEMINI_API_KEY=

SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=simran

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_MODEL_KN=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
KANNADA_TTS_PROVIDER=sarvam

# Optional — only if using the LiveKit voice_agent worker
# LIVEKIT_URL=wss://xxxx.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
